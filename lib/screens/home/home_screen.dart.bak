  // =====================================================
  // SHARE DAILY MESSAGE
  // =====================================================

  Future<void> _shareDailyMessage() async {
    final message = _todayMessageFromFirebase ?? _getTodayMessage();

    final text = '🔮 Bugünün Mesajı\n\n$message\n\n✨ Cosmica';

    await SharePlus.instance.share(
      ShareParams(text: text),
    );
  }

  // =====================================================
  // SHARE HOROSCOPE
  // =====================================================

  Future<void> _shareHoroscope() async {
    final sunSign = _getSunSign();
    final dailyComment = _getDailyComment();
    final emoji = _getSignEmoji(sunSign);

    final text = '$emoji $sunSign - Günün Burç Yorumu\n\n'
        '$dailyComment\n\n✨ Cosmica';

    await SharePlus.instance.share(
      ShareParams(text: text),
    );
  }

  // =====================================================
  // INIT
  // =====================================================

  @override
  void initState() {
    super.initState();
    _syncTodayMessage();
    _loadBirthChart();
  }

  // =====================================================
  // BUILD
  // =====================================================

  @override
  Widget build(BuildContext context) {
    final user = FirebaseAuth.instance.currentUser;
    final theme = Theme.of(context);

    return StreamBuilder<DocumentSnapshot>(
      stream: user == null
          ? null
          : FirebaseFirestore.instance
              .collection('users')
              .doc(user.uid)
              .snapshots(),
      builder: (context, snapshot) {
        String name = user?.displayName ?? 'Cosmica';

        if (snapshot.hasData && snapshot.data!.exists) {
          final rawData = snapshot.data!.data();

          if (rawData is Map<String, dynamic>) {
            if (rawData['name'] != null &&
                rawData['name'].toString().isNotEmpty) {
              name = rawData['name'].toString();
            }
          }
        }

        final sunSign = _getSunSign();
        final sunEmoji = _getSignEmoji(sunSign);
        final todayMessage =
            _todayMessageFromFirebase ?? _getTodayMessage();

        return SafeArea(
          child: SingleChildScrollView(
            physics: const BouncingScrollPhysics(),
            padding: const EdgeInsets.fromLTRB(20, 18, 20, 30),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Text(
                            '✨ Günaydın, $name',
                            style: TextStyle(
                              fontSize: 27,
                              fontWeight: FontWeight.w700,
                              color: theme.colorScheme.onSurface,
                            ),
                          ),
                          const SizedBox(height: 7),
                          Text(
                            'Bugün gökyüzü sana ne söylüyor?',
                            style: TextStyle(
                              fontSize: 15,
                              color: theme.colorScheme.onSurface
                                  .withValues(alpha: 0.6),
                            ),
                          ),
                        ],
                      ),
                    ),
                    StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                      stream: user == null
                          ? null
                          : FirebaseFirestore.instance
                              .collection('users')
                              .doc(user.uid)
                              .collection('notifications')
                              .where('isRead', isEqualTo: false)
                              .snapshots(),
                      builder: (context, snapshot) {
                        final unreadCount = snapshot.data?.docs.length ?? 0;

                        return Container(
                          width: 46,
                          height: 46,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            color: theme.colorScheme.surface,
                            border: Border.all(
                              color: const Color(0xFF8B5CF6)
                                  .withValues(alpha: 0.35),
                            ),
                          ),
                          child: Stack(
                            clipBehavior: Clip.none,
                            children: [
                              Positioned.fill(
                                child: IconButton(
                                  tooltip: 'Bildirimler',
                                  onPressed: () {
                                    Navigator.of(context).push(
                                      MaterialPageRoute(
                                        builder: (_) =>
                                            const NotificationsScreen(),
                                      ),
                                    );
                                  },
                                  icon: Icon(
                                    Icons.notifications_none_rounded,
                                    color: theme.colorScheme.onSurface
                                        .withValues(alpha: 0.7),
                                  ),
                                ),
                              ),
                              if (unreadCount > 0)
                                Positioned(
                                  right: -3,
                                  top: -4,
                                  child: Container(
                                    padding: const EdgeInsets.symmetric(
                                      horizontal: 5,
                                      vertical: 3,
                                    ),
                                    decoration: const BoxDecoration(
                                      color: Color(0xFFEF4444),
                                      shape: BoxShape.circle,
                                    ),
                                    constraints: const BoxConstraints(
                                      minWidth: 18,
                                      minHeight: 18,
                                    ),
                                    child: Center(
                                      child: Text(
                                        unreadCount > 99
                                            ? '99+'
                                            : '$unreadCount',
                                        style: const TextStyle(
                                          color: Colors.white,
                                          fontSize: 10,
                                          fontWeight: FontWeight.bold,
                                        ),
                                      ),
                                    ),
                                  ),
                                ),
                            ],
                          ),
                        );
                      },
                    ),
                  ],
                ),
                const SizedBox(height: 28),

                // KOZMİK PROFİL
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(22),
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(28),
                    gradient: const LinearGradient(
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                      colors: [
                        Color(0xFF6D28D9),
                        Color(0xFF312E81),
                        Color(0xFF17102D),
                      ],
                    ),
                    boxShadow: [
                      BoxShadow(
                        color: const Color(0xFF6D28D9)
                            .withValues(alpha: 0.22),
                        blurRadius: 25,
                        offset: const Offset(0, 10),
                      ),
                    ],
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          const Icon(
                            Icons.auto_awesome,
                            size: 18,
                            color: Colors.white70,
                          ),
                          const SizedBox(width: 8),
                          const Text(
                            'KOZMİK PROFİLİN',
                            style: TextStyle(
                              fontSize: 12,
                              letterSpacing: 2,
                              color: Colors.white70,
                              fontWeight: FontWeight.w600,
                            ),
                          ),
                          const Spacer(),
                          if (_loading)
                            const SizedBox(
                              width: 15,
                              height: 15,
                              child: CircularProgressIndicator(
                                strokeWidth: 1.5,
                                color: Colors.white70,
                              ),
                            ),
                        ],
                      ),
                      const SizedBox(height: 22),
                      Row(
                        children: [
                          Expanded(
                            child: _AstroItem(
                              icon: '☀️',
                              title: 'Güneş',
                              value: _loading ? '...' : sunSign,
                            ),
                          ),
                          Expanded(
                            child: _AstroItem(
                              icon: '🌙',
                              title: 'Ay',
                              value: _loading ? '...' : _getMoonSign(),
                            ),
                          ),
                          Expanded(
                            child: _AstroItem(
                              icon: '⬆️',
                              title: 'Yükselen',
                              value: _loading ? '...' : _getRisingSign(),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 28),

                // BUGÜNÜN MESAJI
                Text(
                  'Bugünün Mesajı',
                  style: TextStyle(
                    fontSize: 21,
                    fontWeight: FontWeight.w700,
                    color: theme.colorScheme.onSurface,
                  ),
                ),
                const SizedBox(height: 13),
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(23),
                  decoration: BoxDecoration(
                    color: theme.colorScheme.surface,
                    borderRadius: BorderRadius.circular(24),
                    border: Border.all(
                      color: theme.colorScheme.onSurface
                          .withValues(alpha: 0.06),
                    ),
                  ),
                  child: Stack(
                    children: [
                      Padding(
                        padding: const EdgeInsets.only(
                          top: 4,
                          right: 35,
                          left: 4,
                        ),
                        child: Column(
                          children: [
                            Container(
                              width: 66,
                              height: 66,
                              decoration: BoxDecoration(
                                shape: BoxShape.circle,
                                color: const Color(0xFF6D28D9)
                                    .withValues(alpha: 0.20),
                              ),
                              child: const Center(
                                child: Text(
                                  '🔮',
                                  style: TextStyle(fontSize: 32),
                                ),
                              ),
                            ),
                            const SizedBox(height: 17),
                            Text(
                              todayMessage,
                              textAlign: TextAlign.center,
                              style: TextStyle(
                                fontSize: 18,
                                height: 1.4,
                                fontWeight: FontWeight.w600,
                                color: theme.colorScheme.onSurface,
                              ),
                            ),
                          ],
                        ),
                      ),
                      Positioned(
                        top: 0,
                        right: 0,
                        child: IconButton(
                          onPressed: _shareDailyMessage,
                          tooltip: 'Paylaş',
                          icon: const Icon(
                            Icons.share_rounded,
                            size: 20,
                            color: Color(0xFFB794F4),
                          ),
                          splashRadius: 22,
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 28),

                // GÜNÜN BURÇ YORUMU
                Row(
                  children: [
                    Expanded(
                      child: Text(
                        'Günün Burç Yorumu',
                        style: TextStyle(
                          fontSize: 21,
                          fontWeight: FontWeight.w700,
                          color: theme.colorScheme.onSurface,
                        ),
                      ),
                    ),
                    Text(
                      sunEmoji,
                      style: const TextStyle(fontSize: 25),
                    ),
                  ],
                ),
                const SizedBox(height: 13),
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.all(21),
                  decoration: BoxDecoration(
                    color: theme.colorScheme.surface,
                    borderRadius: BorderRadius.circular(24),
                    border: Border.all(
                      color: const Color(0xFF8B5CF6)
                          .withValues(alpha: 0.12),
                    ),
                  ),
                  child: Stack(
                    children: [
                      Padding(
                        padding: const EdgeInsets.only(right: 35),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                Container(
                                  width: 45,
                                  height: 45,
                                  decoration: BoxDecoration(
                                    shape: BoxShape.circle,
                                    color: const Color(0xFF6D28D9)
                                        .withValues(alpha: 0.18),
                                  ),
                                  child: Center(
                                    child: Text(
                                      sunEmoji,
                                      style: const TextStyle(fontSize: 23),
                                    ),
                                  ),
                                ),
                                const SizedBox(width: 12),
                                Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(
                                      _loading ? 'Burcun' : sunSign,
                                      style: TextStyle(
                                        fontSize: 18,
                                        fontWeight: FontWeight.w700,
                                        color: theme.colorScheme.onSurface,
                                      ),
                                    ),
                                    const SizedBox(height: 3),
                                    Text(
                                      _dailyHoroscopeLoading
                                          ? 'Gökyüzü okunuyor'
                                          : 'Bugünün yorumu',
                                      style: TextStyle(
                                        color: theme.colorScheme.onSurface
                                            .withValues(alpha: 0.5),
                                        fontSize: 12,
                                      ),
                                    ),
                                  ],
                                ),
                              ],
                            ),
                            const SizedBox(height: 17),
                            Text(
                              _loading || _dailyHoroscopeLoading
                                  ? 'Bugünün gökyüzü okunuyor...'
                                  : _getDailyComment(),
                              style: TextStyle(
                                color: theme.colorScheme.onSurface
                                    .withValues(alpha: 0.7),
                                height: 1.55,
                                fontSize: 15,
                              ),
                            ),
                          ],
                        ),
                      ),
                      Positioned(
                        top: -8,
                        right: -8,
                        child: IconButton(
                          onPressed: _loading || _dailyHoroscopeLoading
                              ? null
                              : _shareHoroscope,
                          tooltip: 'Paylaş',
                          icon: Icon(
                            Icons.share_rounded,
                            size: 20,
                            color: _loading || _dailyHoroscopeLoading
                                ? theme.colorScheme.onSurface
                                    .withValues(alpha: 0.2)
                                : const Color(0xFFB794F4),
                          ),
                          splashRadius: 22,
                        ),
                      ),
                    ],
                  ),
                ),
                const SizedBox(height: 28),

                // GÖKYÜZÜ GÜNDEMİ
                Text(
                  'Gökyüzü Gündemi',
                  style: TextStyle(
                    fontSize: 21,
                    fontWeight: FontWeight.w700,
                    color: theme.colorScheme.onSurface,
                  ),
                ),
                const SizedBox(height: 13),
                Row(
                  children: [
                    Expanded(
                      child: _SkyCard(
                        icon: '🌙',
                        title: 'Ay',
                        subtitle: 'Duygular',
                        description:
                            'Bugün iç sesine kulak vermek için biraz alan aç.',
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: _SkyCard(
                        icon: '✨',
                        title: 'Enerji',
                        subtitle: 'Yeni başlangıçlar',
                        description:
                            'Yeni bir fikir için küçük bir adım at.',
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 24),

                // BIORHYTHM + NUMEROLOGY
                if (snapshot.hasData && snapshot.data!.exists)
                  Builder(
                    builder: (context) {
                      final rawData = snapshot.data!.data();

                      if (rawData is! Map<String, dynamic>) {
                        return const SizedBox.shrink();
                      }

                      final birthDate = rawData['birthDate'];

                      if (birthDate is! Timestamp) {
                        return const SizedBox.shrink();
                      }

                      return Column(
                        children: [
                          BiorhythmCard(
                            birthDate: birthDate.toDate(),
                          ),
                          const SizedBox(height: 24),
                          NumerologyCard(
                            birthDate: birthDate.toDate(),
                          ),
                          const SizedBox(height: 28),
                        ],
                      );
                    },
                  ),

                // TAROT
                GestureDetector(
                  onTap: () {
                    Navigator.of(context).push(
                      MaterialPageRoute(
                        builder: (_) => const TarotScreen(),
                      ),
                    );
                  },
                  child: Container(
                    width: double.infinity,
                    padding: const EdgeInsets.all(20),
                    decoration: BoxDecoration(
                      borderRadius: BorderRadius.circular(24),
                      gradient: const LinearGradient(
                        colors: [
                          Color(0xFF251342),
                          Color(0xFF17102D),
                        ],
                      ),
                      border: Border.all(
                        color: const Color(0xFF8B5CF6)
                            .withValues(alpha: 0.18),
                      ),
                    ),
                    child: Row(
                      children: [
                        Container(
                          width: 55,
                          height: 55,
                          decoration: BoxDecoration(
                            borderRadius: BorderRadius.circular(17),
                            color: const Color(0xFF6D28D9)
                                .withValues(alpha: 0.22),
                          ),
                          child: const Center(
                            child: Text(
                              '🃏',
                              style: TextStyle(fontSize: 27),
                            ),
                          ),
                        ),
                        const SizedBox(width: 15),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                'Tarotuna Bak',
                                style: TextStyle(
                                  fontSize: 17,
                                  fontWeight: FontWeight.w700,
                                  color: theme.colorScheme.onSurface,
                                ),
                              ),
                              const SizedBox(height: 4),
                              Text(
                                'Bugünün enerjisi için bir kart seç.',
                                style: TextStyle(
                                  color: theme.colorScheme.onSurface
                                      .withValues(alpha: 0.5),
                                  fontSize: 13,
                                ),
                              ),
                            ],
                          ),
                        ),
                        Icon(
                          Icons.arrow_forward_ios_rounded,
                          size: 16,
                          color: theme.colorScheme.onSurface
                              .withValues(alpha: 0.5),
                        ),
                      ],
                    ),
                  ),
                ),
                const SizedBox(height: 20),
              ],
            ),
          ),
        );
      },
    );
  }
}

// =====================================================
// ASTRO ITEM
// =====================================================

class _AstroItem extends StatelessWidget {
  final String icon;
  final String title;
  final String value;

  const _AstroItem({
    required this.icon,
    required this.title,
    required this.value,
  });

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Column(
      children: [
        Text(icon, style: const TextStyle(fontSize: 25)),
        const SizedBox(height: 8),
        Text(
          title,
          style: TextStyle(
            fontSize: 12,
            color: theme.colorScheme.onSurface.withValues(alpha: 0.6),
          ),
        ),
        const SizedBox(height: 5),
        Text(
          value,
          textAlign: TextAlign.center,
          maxLines: 1,
          overflow: TextOverflow.ellipsis,
          style: TextStyle(
            fontSize: 14,
            fontWeight: FontWeight.w700,
            color: theme.colorScheme.onSurface,
          ),
        ),
      ],
    );
  }
}

// =====================================================
// SKY CARD
// =====================================================

class _SkyCard extends StatelessWidget {
  final String icon;
  final String title;
  final String subtitle;
  final String description;

  const _SkyCard({
    required this.icon,
    required this.title,
    required this.subtitle,
    required this.description,
  });

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Container(
      padding: const EdgeInsets.all(17),
      decoration: BoxDecoration(
        color: theme.colorScheme.surface,
        borderRadius: BorderRadius.circular(22),
        border: Border.all(
          color: theme.colorScheme.onSurface.withValues(alpha: 0.05),
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(icon, style: const TextStyle(fontSize: 27)),
          const SizedBox(height: 13),
          Text(
            title,
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.w700,
              color: theme.colorScheme.onSurface,
            ),
          ),
          const SizedBox(height: 3),
          Text(
            subtitle,
            style: const TextStyle(
              color: Color(0xFFA78BFA),
              fontSize: 12,
              fontWeight: FontWeight.w600,
            ),
          ),
          const SizedBox(height: 10),
          Text(
            description,
            style: TextStyle(
              color: theme.colorScheme.onSurface.withValues(alpha: 0.5),
              fontSize: 12,
              height: 1.45,
            ),
          ),
        ],
      ),
    );
  }
}

