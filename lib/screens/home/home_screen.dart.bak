  String _getTodayMessage() {
    final now = DateTime.now();
    final startOfYear = DateTime(now.year, 1, 1);
    final dayOfYear = now.difference(startOfYear).inDays;
    final index = dayOfYear % _dailyMessages.length;
    return _dailyMessages[index];
  }

  Future<void> _syncTodayMessage() async {
    try {
      final message = await DailyMessageService.syncTodayMessage(
        fallbackMessage: _getTodayMessage(),
      );

      if (!mounted) return;

      setState(() {
        _todayMessageFromFirebase = message;
      });
    } catch (e) {
      debugPrint('Günlük mesaj senkronizasyon hatası: $e');
    }
  }

  // =====================================================
  // BIRTH CHART
  // =====================================================

  Future<void> _loadBirthChart() async {
    try {
      final user = FirebaseAuth.instance.currentUser;

      if (user == null) {
        if (mounted) {
          setState(() {
            _loading = false;
          });
        }
        return;
      }

      final userDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(user.uid)
          .get();

      final data = userDoc.data();

      if (data == null) {
        if (mounted) {
          setState(() {
            _loading = false;
          });
        }
        return;
      }

      final birthDate = data['birthDate'] as Timestamp;
      final birthTimeHour = data['birthTimeHour'] as int;
      final birthTimeMinute = data['birthTimeMinute'] as int;
      final birthPlace = data['birthPlace'] as String;

      final date = birthDate.toDate();

      final formattedDate =
          '${date.day.toString().padLeft(2, '0')}.'
          '${date.month.toString().padLeft(2, '0')}.'
          '${date.year}';

      final formattedTime =
          '${birthTimeHour.toString().padLeft(2, '0')}:'
          '${birthTimeMinute.toString().padLeft(2, '0')}';

      debugPrint('📤 API YE GİDEN VERİ:');
      debugPrint('birth_date: $formattedDate');
      debugPrint('birth_time: $formattedTime');
      debugPrint('city: $birthPlace');

      final result = await BirthChartService.getBirthChart(
        birthDate: formattedDate,
        birthTime: formattedTime,
        city: birthPlace,
      );

      debugPrint('🔥 DOĞUM HARİTASI API SONUCU:');
      debugPrint(result.toString());

      if (mounted) {
        setState(() {
          _birthChart = result;
          _loading = false;
        });
      }

      final sunSign = _getSunSign();

      if (sunSign != '—') {
        await _loadDailyHoroscope(sunSign);
      }
    } catch (e) {
      debugPrint('❌ DOĞUM HARİTASI API HATASI: $e');

      if (mounted) {
        setState(() {
          _loading = false;
        });
      }
    }
  }

  // =====================================================
  // DAILY HOROSCOPE API
  // =====================================================

  Future<void> _loadDailyHoroscope(String sign) async {
    if (sign == '—' || sign.trim().isEmpty) return;

    if (mounted) {
      setState(() {
        _dailyHoroscopeLoading = true;
      });
    }

    try {
      debugPrint('🔮 GÜNLÜK BURÇ API ÇAĞRISI: $sign');
      await HoroscopeService.getDailyData(sign);
      debugPrint('🔮 GÜNLÜK BURÇ API ÇAĞRISI TAMAMLANDI');

      if (!mounted) return;

      setState(() {
        _dailyHoroscopeLoading = false;
      });
    } catch (e) {
      debugPrint('❌ GÜNLÜK BURÇ API HATASI: $e');

      if (!mounted) return;

      setState(() {
        _dailyHoroscopeLoading = false;
      });
    }
  }

  // =====================================================
  // SUN / MOON / RISING
  // =====================================================

  String _getSunSign() {
    final placements = _birthChart?['core_placements'];

    if (placements is Map) {
      final sign = placements['sign'];

      if (sign != null && sign.toString().trim().isNotEmpty) {
        return sign.toString();
      }
    }

    return '—';
  }

  String _getMoonSign() {
    final moon = _birthChart?['moon'];

    if (moon is Map) {
      final sign = moon['sign'];

      if (sign != null && sign.toString().trim().isNotEmpty) {
        return sign.toString();
      }
    }

    return '—';
  }

  String _getRisingSign() {
    final rising = _birthChart?['rising'];

    if (rising is Map) {
      final sign = rising['sign'];

      if (sign != null && sign.toString().trim().isNotEmpty) {
        return sign.toString();
      }
    }

    return '—';
  }

  // =====================================================
  // SIGN EMOJI
  // =====================================================

  String _getSignEmoji(String sign) {
    final lower = sign.toLowerCase();

    if (lower.contains('koç') || lower.contains('aries')) return '♈';
    if (lower.contains('boğa') || lower.contains('taurus')) return '♉';
    if (lower.contains('ikizler') || lower.contains('gemini')) return '♊';
    if (lower.contains('yengeç') || lower.contains('cancer')) return '♋';
    if (lower.contains('aslan') || lower.contains('leo')) return '♌';
    if (lower.contains('başak') || lower.contains('virgo')) return '♍';
    if (lower.contains('terazi') || lower.contains('libra')) return '♎';
    if (lower.contains('akrep') || lower.contains('scorpio')) return '♏';
    if (lower.contains('yay') || lower.contains('sagittarius')) return '♐';
    if (lower.contains('oğlak') || lower.contains('capricorn')) return '♑';
    if (lower.contains('kova') || lower.contains('aquarius')) return '♒';
    if (lower.contains('balık') || lower.contains('pisces')) return '♓';

    return '✨';
  }

